{
  "name": "@pcmid/dsh-web-search-native",
  "version": "0.3.3",
  "description": "Web search provider that uses the model API's built-in web search on the small model, or on the conversation's current model. Currently supports Anthropic Messages routes.",
  "author": "pcmid",
  "homepage": "https://github.com/pcmid/dsh-plugins/tree/main/plugins/dsh-web-search-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcmid/dsh-plugins.git",
    "directory": "plugins/dsh-web-search-native"
  },
  "private": true,
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
