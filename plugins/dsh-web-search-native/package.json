{
  "name": "@pcmid/dsh-web-search-native",
  "version": "0.5.0",
  "description": "Web search provider that runs the model API's built-in web search, following the conversation or on one pinned channel, and adds a search-channel section to the Web search plugin page.",
  "author": "pcmid",
  "homepage": "https://github.com/pcmid/dsh-plugins/tree/main/plugins/dsh-web-search-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcmid/dsh-plugins.git",
    "directory": "plugins/dsh-web-search-native"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import ./test/hooks.mjs --test test/backend.test.mjs test/client.test.mjs"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
