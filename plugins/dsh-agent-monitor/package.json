{
  "name": "@pcmid/dsh-agent-monitor",
  "version": "0.1.0",
  "description": "Shows above the message box what each agent of the session is doing: working, waiting for background work, or idle.",
  "author": "pcmid",
  "license": "MIT",
  "homepage": "https://github.com/pcmid/dsh-plugins/tree/main/plugins/dsh-agent-monitor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcmid/dsh-plugins.git",
    "directory": "plugins/dsh-agent-monitor"
  },
  "private": true,
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/host.test.mjs test/client.test.mjs",
    "test:e2e": "node test/e2e/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
