{
  "name": "@pcmid/dsh-codex-provider",
  "version": "0.2.2",
  "description": "Use your local Codex login and models as a DSH model provider; DSH runs the tools and each session keeps one Codex thread.",
  "author": "pcmid",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcmid/dsh-plugins.git",
    "directory": "plugins/dsh-codex-provider"
  },
  "engines": { "dsh": ">=0.2.2-rc.1 <0.3.0-0", "node": ">=24" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "app-server.js", "conversation.js", "history.js", "models-dev.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --import ./test/hooks.mjs --test --test-isolation=none test/adapter.test.mjs test/app-server.test.mjs test/models-dev.test.mjs",
    "test:client": "node --test test/client.test.mjs",
    "test:e2e": "node --import ./test/hooks.mjs --test --test-isolation=none test/e2e.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-settings-models"] }
  }
}
