{
  "name": "@pcmid/dsh-superagent",
  "version": "0.10.0",
  "description": "An autonomous supervisor for authorized Feishu mentions, DSH workers and their thread replies.",
  "author": "pcmid",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "host",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node scripts/build-client.mjs --check && node --check client.js && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "zod": "^4.6.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
