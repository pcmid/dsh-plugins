{
  "name": "@pcmid/dsh-remote-relay",
  "version": "0.2.9",
  "description": "Switch between DSH hosts that have this plugin, or reach this DSH from a phone, through a self-hosted OpenChamber relay, end-to-end encrypted.",
  "author": "pcmid",
  "homepage": "https://github.com/pcmid/dsh-plugins/tree/main/plugins/dsh-remote-relay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcmid/dsh-plugins.git",
    "directory": "plugins/dsh-remote-relay"
  },
  "private": true,
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "remotes.js",
    "loopback.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "launcher/",
    "README.md"
  ],
  "scripts": {
    "test": "node --import ./test/hooks.mjs --test test/qr.test.mjs test/protocol.test.mjs test/host.test.mjs test/switcher.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
