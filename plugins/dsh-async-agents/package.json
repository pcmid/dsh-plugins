{
  "name": "@pcmid/dsh-async-agents",
  "version": "0.1.0",
  "description": "Keeps the main agent of a session from blocking on background work: long shell commands move to background jobs, and the agent ends its turn instead of waiting for jobs or subagents.",
  "author": "pcmid",
  "license": "MIT",
  "homepage": "https://github.com/pcmid/dsh-plugins/tree/main/plugins/dsh-async-agents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcmid/dsh-plugins.git",
    "directory": "plugins/dsh-async-agents"
  },
  "private": true,
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/async-agents.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
