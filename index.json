    {
      "name": "@pcmid/dsh-retry-advisor",
      "title": {
        "en": "AI retry advisor",
        "zh": "AI 重试判断"
      },
      "description": {
        "en": "When a model request fails and no built-in handler retries it, analyzes the cause on the conversation's model and reasoning effort, decides whether and when to resend, and shows the decision in the conversation. If the analysis itself fails, the request is not retried.",
        "zh": "模型请求失败且内置机制不再重试时，用会话当前的模型和思考等级分析错误原因，决定是否重发、等多久再发，并在对话里显示判断结果。分析本身失败时不重试。"
      },
      "icon": "data:image/svg+xml;base64,",
      "author": "pcmid",
      "homepage": "https://github.com/pcmid/dsh-plugins/tree/main/plugins/dsh-retry-advisor#readme",
      "repository": {
        "url": "https://github.com/pcmid/dsh-plugins",
        "directory": "plugins/dsh-retry-advisor"
      },
