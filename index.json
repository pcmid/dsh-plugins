      "name": "@pcmid/dsh-todo-guard",
      "title": {
        "en": "Todo progress guard",
        "zh": "任务进度守卫"
      },
      "description": {
        "en": "When the agent works for several steps without updating its task list, reminds it to update the list, repeating the current items. Optionally marks leftover items completed when a turn ends normally.",
