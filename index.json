    {
      "name": "@pcmid/dsh-web-search-native",
      "title": {
        "en": "Native web search",
        "zh": "接口原生网页搜索"
      },
      "description": {
        "en": "Backs the web_search tool with the model API's built-in web search, running on the conversation's provider with a per-provider search model. Supports Anthropic Messages and OpenAI Responses routes.",
        "zh": "用模型接口自带的网页搜索为 web_search 工具提供后端，在会话所用的供应商上执行，每个供应商可指定自己的搜索模型。支持 Anthropic Messages 和 OpenAI Responses 路由。"
      },
