    {
      "name": "@local/dsh-retry-advisor",
      "title": {
        "en": "AI retry advisor",
        "zh": "AI 重试判断"
      },
      "description": {
        "en": "When a model request fails and no built-in handler retries it, asks a model to analyze the cause and decide whether and when to resend. If the analysis itself fails, the request is not retried.",
        "zh": "模型请求失败且内置机制不再重试时，让模型分析错误原因，决定是否重发、等多久再发。分析本身失败时不重试。"
      },
      "icon": "data:image/svg+xml;base64,",
      "author": "pcmid",
      "homepage": "https://github.com/pcmid/dsh-plugins/tree/main/plugins/dsh-retry-advisor#readme",
